# Copy this file to `.env` and paste in your real key:
#     cp .env.example .env
# Then edit .env. The real .env is gitignored, so your key never reaches GitHub.
#
# Get a key at https://console.anthropic.com/  ->  Settings  ->  API Keys.
# You only need this for the `claude` backend; `mock` and `ollama` don't use it.

ANTHROPIC_API_KEY=sk-ant-your-real-key-goes-here
